# syntax=docker/dockerfile:1.7
ARG POSTGRES_IMAGE=postgres:18.4-alpine
FROM ${POSTGRES_IMAGE}
LABEL org.opencontainers.image.title="Merchant Platform schema migrator"
# The migrator runs as an explicit non-root UID and never invokes the
# PostgreSQL image entrypoint, so retaining its Go-built privilege helper only
# adds an unused executable to the attack surface.
# hadolint ignore=DL3018
RUN apk add --no-cache --upgrade \
      'c-ares>=1.34.8-r0' \
      'libcrypto3>=3.5.8-r0' \
      'libssl3>=3.5.8-r0' \
    && rm -f /usr/local/bin/gosu
COPY --chmod=0555 deploy/postgres/run-migrations.sh /usr/local/bin/merchant-migrate
COPY --chmod=0444 deploy/postgres/bootstrap-roles.sql /deploy/bootstrap-roles.sql
COPY --chmod=0444 deploy/postgres/runtime-grants.sql /deploy/runtime-grants.sql
COPY --chmod=0444 backend/migrations/ /deploy/migrations/
# Docker versions differ in whether COPY --chmod also changes pre-existing
# parent directories. Keep copied files read-only, but make both directory
# levels traversable by the non-root migrator.
RUN chmod 0555 /deploy /deploy/migrations
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/merchant-migrate"]
