# Local-only placeholders. Copy to infra/.env (ignored by Git) and replace every
# enabled workload value. Never reuse production credentials in Compose.
POSTGRES_DB=merchant
POSTGRES_USER=merchant_migrator
POSTGRES_PASSWORD=replace-with-a-random-local-password

# Distinct login URLs inheriting one NOLOGIN capability role each. The sample
# repeats a password only so `docker compose config` can run; production must not.
MIGRATION_DATABASE_URL=postgres://merchant_migrator:replace-me@postgres:5432/merchant?sslmode=disable
API_DATABASE_URL=postgres://merchant_api:replace-me@postgres:5432/merchant?sslmode=disable
MANAGEMENT_DATABASE_URL=postgres://merchant_management:replace-me@postgres:5432/merchant?sslmode=disable
ADMIN_DATABASE_URL=postgres://merchant_admin:replace-me@postgres:5432/merchant?sslmode=disable
PLATFORM_ADMIN_DATABASE_URL=postgres://merchant_platform_admin:replace-me@postgres:5432/merchant?sslmode=disable
MIGRATION_ACTUATOR_DATABASE_URL=postgres://migration_traffic_actuator_login:replace-me@postgres:5432/merchant?sslmode=disable
MIGRATION_TRAFFIC_ACTUATOR_DATABASE_URL=postgres://migration_traffic_actuator_job_login:replace-me@postgres:5432/merchant?sslmode=disable
MIGRATION_CONTROL_DATABASE_URL=postgres://migration_control_worker_login:replace-me@postgres:5432/merchant?sslmode=disable
SETTLEMENT_DATABASE_URL=postgres://merchant_settlement:replace-me@postgres:5432/merchant?sslmode=disable
MATCHING_DATABASE_URL=postgres://merchant_matching:replace-me@postgres:5432/merchant?sslmode=disable
CALLBACK_DATABASE_URL_FILE=/absolute/path/to/callback-database-url
OUTBOX_DATABASE_URL=postgres://merchant_outbox:replace-me@postgres:5432/merchant?sslmode=disable
PLAN_DATABASE_URL=postgres://merchant_plan:replace-me@postgres:5432/merchant?sslmode=disable
RESOLUTION_DATABASE_URL=postgres://merchant_resolution:replace-me@postgres:5432/merchant?sslmode=disable
PROOF_DATABASE_URL=postgres://merchant_proof:replace-me@postgres:5432/merchant?sslmode=disable
SCANNER_DATABASE_URL=postgres://merchant_scanner:replace-me@postgres:5432/merchant?sslmode=disable
PROVIDER_HEALTH_DATABASE_URL=postgres://merchant_provider_health_worker_login:replace-me@postgres:5432/merchant?sslmode=disable
PLATFORM_OUTBOX_DATABASE_URL=postgres://platform_outbox_publisher_login:replace-me@postgres:5432/merchant?sslmode=disable
RATE_DATABASE_URL=postgres://merchant_rate:replace-me@postgres:5432/merchant?sslmode=disable
RECONCILIATION_DATABASE_URL=postgres://merchant_reconciliation_worker_login:replace-me@postgres:5432/merchant?sslmode=disable
RETENTION_DATABASE_URL=postgres://retention_archive_worker_login:replace-me@postgres:5432/merchant?sslmode=disable
RETENTION_CONTROL_DATABASE_URL=postgres://retention_control_scheduler_login:replace-me@postgres:5432/merchant?sslmode=disable
LEGACY_DATABASE_URL=postgres://legacy_compat_runtime_login:replace-me@postgres:5432/merchant?sslmode=disable
LEGACY_REQUESTER_DATABASE_URL=postgres://legacy_compat_requester_login:replace-me@postgres:5432/merchant?sslmode=disable
LEGACY_APPROVER_DATABASE_URL=postgres://legacy_compat_approver_login:replace-me@postgres:5432/merchant?sslmode=disable
MERCHANT_SETTINGS_DATABASE_URL=postgres://merchant_settings_api_runtime_login:replace-me@postgres:5432/merchant?sslmode=disable
MERCHANT_SESSION_REVOCATION_DATABASE_URL=postgres://merchant_session_revocation_worker_login:replace-me@postgres:5432/merchant?sslmode=disable
MERCHANT_INVITATION_DELIVERY_DATABASE_URL=postgres://merchant_invitation_delivery_worker_login:replace-me@postgres:5432/merchant?sslmode=disable
FINANCIAL_API_DATABASE_URL=postgres://merchant_financial_api:replace-me@postgres:5432/merchant?sslmode=disable
FINANCIAL_WORKER_DATABASE_URL=postgres://merchant_financial_worker:replace-me@postgres:5432/merchant?sslmode=disable

PUBLIC_BASE_URL=https://merchant.example.invalid
RATE_SOURCE_GATEWAY_ENABLED=true
API_CREDENTIAL_ENVELOPE_KEY=replace-with-base64url-32-byte-key
ADMIN_PUBLIC_ORIGIN=https://admin.example.invalid
ADMIN_OIDC_ISSUER=https://identity.example.invalid
ADMIN_OIDC_CLIENT_ID=merchant-admin
ADMIN_OIDC_CLIENT_SECRET=replace-me
ADMIN_OIDC_REDIRECT_URI=https://admin.example.invalid/admin/v1/auth/callback
ADMIN_STATE_ENCRYPTION_KEY=replace-with-base64url-32-byte-key

# Independent key/certificate files, all untracked. TLS certificates must contain
# service DNS SANs used by the admin BFF/gateway.
WEBHOOK_ENVELOPE_KEY_FILE=/absolute/path/to/webhook-envelope.key
API_CREDENTIAL_ENVELOPE_KEY_FILE=/absolute/path/to/api-credential-envelope.key
MANAGEMENT_RESPONSE_KEY_FILE=/absolute/path/to/management-response.key
MANAGEMENT_ASSERTION_KEY_FILE=/absolute/path/to/management-assertion.key
MANAGEMENT_CA_FILE=/absolute/path/to/management-ca.pem
MANAGEMENT_TLS_CERT_FILE=/absolute/path/to/management-tls.crt
MANAGEMENT_TLS_KEY_FILE=/absolute/path/to/management-tls.key
RECEIPT_AI_API_KEY_FILE=/absolute/path/to/polza-api-key
PLATFORM_ASSERTION_KEY_FILE=/absolute/path/to/platform-assertion.key
PLATFORM_CA_FILE=/absolute/path/to/platform-ca.pem
PLATFORM_TLS_CERT_FILE=/absolute/path/to/platform-tls.crt
PLATFORM_TLS_KEY_FILE=/absolute/path/to/platform-tls.key
MIGRATION_MANIFEST_PUBLIC_KEYS_FILE=/absolute/path/to/migration-manifest-public-keys.json
MIGRATION_ACTUATOR_PUBLIC_KEYS_FILE=/absolute/path/to/migration-actuator-public-keys.json
MIGRATION_VERIFIER_CONFIG_FILE=/absolute/path/to/migration-verifier-config.json
MIGRATION_PROVIDER_PUBLIC_KEYS_FILE=/absolute/path/to/migration-provider-public-keys.json
MIGRATION_PROVIDER_CA_FILE=/absolute/path/to/migration-provider-ca.pem
MIGRATION_PROVIDER_CLIENT_CERT_FILE=/absolute/path/to/migration-provider-client.crt
MIGRATION_PROVIDER_CLIENT_KEY_FILE=/absolute/path/to/migration-provider-client.key
MIGRATION_ACTUATOR_MIGRATION_ID=00000000-0000-7000-8000-000000000021
MIGRATION_ACTUATOR_SWITCH_URL=https://traffic-control.example.invalid:443/v1/migration-actions/apply
MIGRATION_ACTUATOR_SERVER_NAME=traffic-control.example.invalid
MIGRATION_ACTUATOR_CA_FILE=/absolute/path/to/migration-actuator-ca.pem
MIGRATION_ACTUATOR_CLIENT_CERT_FILE=/absolute/path/to/migration-actuator-client.crt
MIGRATION_ACTUATOR_CLIENT_KEY_FILE=/absolute/path/to/migration-actuator-client.key
MIGRATION_ACTUATOR_REQUEST_SIGNING_KEY_FILE=/absolute/path/to/migration-actuator-request.key
MIGRATION_ACTUATOR_REQUEST_KEY_ID=migration-actuator-request-v1
MIGRATION_ACTUATOR_ACK_PUBLIC_KEYS_FILE=/absolute/path/to/migration-actuator-ack-public-keys.json
MIGRATION_ACTUATOR_TIMEOUT_SECONDS=20
MERCHANT_SETTINGS_ASSERTION_KEY_FILE=/absolute/path/to/merchant-settings-assertion.key
MERCHANT_SETTINGS_TLS_CERT_FILE=/absolute/path/to/merchant-settings-tls.crt
MERCHANT_SETTINGS_TLS_KEY_FILE=/absolute/path/to/merchant-settings-tls.key
MERCHANT_SETTINGS_CLIENT_CA_FILE=/absolute/path/to/merchant-settings-client-ca.pem
MERCHANT_SETTINGS_SERVER_CA_FILE=/absolute/path/to/merchant-settings-server-ca.pem
MERCHANT_SETTINGS_INTERNAL_CLIENT_CERT_FILE=/absolute/path/to/admin-merchant-settings-client.crt
MERCHANT_SETTINGS_INTERNAL_CLIENT_KEY_FILE=/absolute/path/to/admin-merchant-settings-client.key
MERCHANT_SETTINGS_INTERNAL_SERVER_NAME=merchant-settings-api
FINANCIAL_INTERNAL_URL=https://financial-api:8444
FINANCIAL_INTERNAL_SERVER_NAME=financial-api
FINANCIAL_INTERNAL_CLIENT_CERT_FILE=/absolute/path/to/admin-financial-client.crt
FINANCIAL_INTERNAL_CLIENT_KEY_FILE=/absolute/path/to/admin-financial-client.key
MERCHANT_INVITE_TOKEN_KEY_RING_DIR_HOST=/absolute/path/to/invitation-token-key-ring-directory
MERCHANT_SETTINGS_EMAIL_INVITES_ENABLED=false
MERCHANT_INVITATION_DELIVERY_WORKER_ID=00000000-0000-7000-8000-000000000003
MERCHANT_SETTINGS_INVITE_NOTIFIER_URL=https://notifier.example.invalid/v1/invitations
MERCHANT_SETTINGS_INVITE_NOTIFIER_BEARER_FILE=/absolute/path/to/invitation-notifier.bearer
MERCHANT_SETTINGS_INVITE_NOTIFIER_CA_FILE=/absolute/path/to/invitation-notifier-ca.pem

PLATFORM_ADMIN_SCHEDULER_ACTOR_ID=00000000-0000-7000-8000-000000000001
RETENTION_CONTROL_WORKER_ID=compose-retention-control-1
MIGRATION_EXECUTE=false
MIGRATION_ID=
MIGRATION_SOURCE_ID=
MIGRATION_WORKER_ID=compose-migration-verifier-1
RATE_WORKER_ID=00000000-0000-7000-8000-000000000002
RATE_TARGETS_JSON=[]
RATE_SECRET_DIR_HOST=./rate-secrets-placeholder
RECONCILIATION_WORKER_ID=reconciliation-1
RECONCILIATION_SIGNING_KEY_ID=reconciliation-v1
RECONCILIATION_S3_ENDPOINT=https://s3.example.invalid
RECONCILIATION_S3_REGION=us-east-1
RECONCILIATION_S3_BUCKET=merchant-reconciliation
RECONCILIATION_API_S3_ACCESS_KEY_ID_FILE=/absolute/path/to/reconciliation-read.access-key-id
RECONCILIATION_API_S3_SECRET_ACCESS_KEY_FILE=/absolute/path/to/reconciliation-read.secret-access-key
RECONCILIATION_WORKER_S3_ACCESS_KEY_ID_FILE=/absolute/path/to/reconciliation-write.access-key-id
RECONCILIATION_WORKER_S3_SECRET_ACCESS_KEY_FILE=/absolute/path/to/reconciliation-write.secret-access-key
RECONCILIATION_SIGNING_PUBLIC_KEY_FILE=/absolute/path/to/reconciliation-ed25519-public.key
RECONCILIATION_SIGNING_PRIVATE_KEY_FILE=/absolute/path/to/reconciliation-ed25519-private.key

# Retention is a separate opt-in worker. These credentials may Put/Get only
# under retention/v1/ and inspect bucket versioning/Object Lock; they may not
# Delete or List. Use an independent Ed25519 private key and production bucket.
RETENTION_WORKER_ID=compose-retention-1
RETENTION_S3_ENDPOINT=https://s3.example.invalid
RETENTION_S3_REGION=us-east-1
RETENTION_S3_BUCKET=merchant-retention
RETENTION_S3_ACCESS_KEY_ID_FILE=/absolute/path/to/retention-write.access-key-id
RETENTION_S3_SECRET_ACCESS_KEY_FILE=/absolute/path/to/retention-write.secret-access-key
RETENTION_S3_SESSION_TOKEN_FILE=/absolute/path/to/retention-write.session-token
RETENTION_SIGNING_PRIVATE_KEY_FILE=/absolute/path/to/retention-ed25519-private.key
RETENTION_SIGNING_KEY_ID=retention-v1

# Temporary legacy adapter. It remains outside the shared HTTP gateway because
# its direct-peer IP policy rejects forwarding headers. Supply a source-
# preserving L4 listener separately and remove this profile at sunset.
LEGACY_PUBLIC_BASE_URL=https://legacy.example.invalid
LEGACY_CHECKOUT_BASE_URL=https://checkout.example.invalid
LEGACY_CORE_URL=https://api.example.invalid
LEGACY_CORE_SERVER_NAME=api.example.invalid
LEGACY_CORE_CA_FILE=/absolute/path/to/core-ca.pem
LEGACY_CORE_CLIENT_CERT_FILE=/absolute/path/to/legacy-core-client.crt
LEGACY_CORE_CLIENT_KEY_FILE=/absolute/path/to/legacy-core-client.key
LEGACY_SECRET_DIR_HOST=/absolute/path/to/legacy-secret-directory
LEGACY_WORKER_ID=compose-legacy-1
LEGACY_SUNSET_AT=2026-12-31T23:59:59Z

# Optional JetStream delivery profile. All credential material is external;
# the server profile publishes no host port and fails on an empty config.
NATS_SERVER_CONFIG_FILE=/absolute/path/to/nats-server.conf
NATS_SERVER_CA_FILE=/absolute/path/to/nats-server-ca.pem
NATS_SERVER_CERT_FILE=/absolute/path/to/nats-server.crt
NATS_SERVER_KEY_FILE=/absolute/path/to/nats-server.key
NATS_OPERATOR_JWT_FILE=/absolute/path/to/nats-operator.jwt
OUTBOX_NATS_CA_FILE=/absolute/path/to/nats-server-ca.pem
OUTBOX_NATS_CLIENT_CERT_FILE=/absolute/path/to/outbox-nats-client.crt
OUTBOX_NATS_CLIENT_KEY_FILE=/absolute/path/to/outbox-nats-client.key
OUTBOX_NATS_CREDS_FILE=/absolute/path/to/outbox-nats-publisher.creds

# Production scanner admission is an atomic set of active platform snapshot
# keys. Provider credentials, when referenced by an RPC snapshot, are mounted
# as <credential_ref>.json beneath this directory.
SCANNER_PLATFORM_RUNTIME_JSON={"chain":"eip155:1","finality":"eip155:1","rpc_providers":["rpc/primary","rpc/secondary"],"assets":["eth-ethereum"],"maintenance":[]}
SCANNER_SECRET_DIR_HOST=./scanner-secrets-placeholder
PROVIDER_HEALTH_SECRET_DIR_HOST=./provider-health-secrets-placeholder

# Static provider fields are accepted only with infra/compose.dev.yaml, whose
# explicit development flag enables the scanner's unsafe static fallback.
SCANNER_CHAIN_ID=
SCANNER_GENESIS_HASH=
SCANNER_PROVIDER_URLS=
SCANNER_PROVIDER_TOKEN=

# One enabled platform_admin_service_identities row with purpose
# outbox_publisher must match this UUID. Do not reuse it for another replica.
PLATFORM_OUTBOX_WORKER_ID=00000000-0000-7000-8000-000000000004
PLATFORM_OUTBOX_DESTINATION_URL=https://events.example.invalid/v1/platform-admin/events
PLATFORM_OUTBOX_DESTINATION_CA_FILE=/absolute/path/to/platform-outbox-destination-ca.pem
PLATFORM_OUTBOX_DESTINATION_CERT_FILE=/absolute/path/to/platform-outbox-destination-client.crt
PLATFORM_OUTBOX_DESTINATION_KEY_FILE=/absolute/path/to/platform-outbox-destination-client.key
PLATFORM_OUTBOX_DESTINATION_TOKEN_FILE=/absolute/path/to/platform-outbox-destination.bearer

FINANCIAL_ASSERTION_KEY_FILE=/absolute/path/to/financial-assertion.key
FINANCIAL_CA_FILE=/absolute/path/to/financial-ca.pem
FINANCIAL_TLS_CERT_FILE=/absolute/path/to/financial-tls.crt
FINANCIAL_TLS_KEY_FILE=/absolute/path/to/financial-tls.key
FINANCIAL_CLIENT_CA_FILE=/absolute/path/to/financial-client-ca.pem
FINANCIAL_MONITOR_CLIENT_CERT_FILE=/absolute/path/to/financial-monitor-client.crt
FINANCIAL_MONITOR_CLIENT_KEY_FILE=/absolute/path/to/financial-monitor-client.key
FINANCIAL_BUILDER_TOKEN_FILE=/absolute/path/to/builder.token
FINANCIAL_SIGNER_TOKEN_FILE=/absolute/path/to/signer.token
FINANCIAL_BROADCASTER_TOKEN_FILE=/absolute/path/to/broadcaster.token
