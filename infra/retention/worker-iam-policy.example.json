{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectWormBucketAdmission",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::merchant-retention"
    },
    {
      "Sid": "WriteAndVerifyRetentionObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::merchant-retention/retention/v1/*"
    },
    {
      "Sid": "DenyEnumerationAndDestruction",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::merchant-retention",
        "arn:aws:s3:::merchant-retention/retention/v1/*"
      ]
    }
  ]
}
