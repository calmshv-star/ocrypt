# Example only. Replace JWT placeholders and use an operator identity to
# provision the stream/consumer. No seed or token belongs in this file.
port: 4222
http: 8222
server_name: merchant-jetstream-local

jetstream {
  store_dir: /data
  max_memory_store: 256MB
  max_file_store: 12GB
}

tls {
  cert_file: /run/secrets/nats-server.crt
  key_file: /run/secrets/nats-server.key
  ca_file: /run/secrets/nats-server-ca.pem
  verify: true
  min_version: "1.3"
  timeout: 2
}

# Operator/account JWT configuration is environment-owned. The Compose
# service fails before launching when its supplied config file is empty.
operator: /run/secrets/nats-operator.jwt
resolver: MEMORY
resolver_preload: {
  REPLACE_WITH_ACCOUNT_PUBLIC_KEY: REPLACE_WITH_SIGNED_ACCOUNT_JWT
}
